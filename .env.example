# GitHub REST API Personal Access Token (Optional, increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=your_github_personal_access_token_here

# Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite Database URL
DATABASE_URL=sqlite:///./opensource_compass.db
